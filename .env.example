# Copie para .env e preencha. Tudo que começa com EXPO_PUBLIC_ vai para dentro
# do app (é público) — nunca coloque chaves secretas aqui.
# Nos builds da EAS, cadastre as mesmas variáveis em: eas env:create (ou no site expo.dev).

# Marca
EXPO_PUBLIC_BRAND_NAME=Prisma Nutri
EXPO_PUBLIC_BRAND_DOMAIN=prismanutri.belter-oracle.com.br
EXPO_PUBLIC_SUPPORT_EMAIL=belter.oracle@gmail.com

# Backend do app web (mesmo servidor: rotas /api/mobile/* e /api/public/auth/*)
EXPO_PUBLIC_API_URL=https://prismanutri.belter-oracle.com.br

# Supabase (as mesmas chaves públicas do web: VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bucket de fotos (VITE_PROFILE_IMAGE_BUCKET no web)
EXPO_PUBLIC_PROFILE_IMAGE_BUCKET=

# RevenueCat (Project settings → API keys → chaves PÚBLICAS de cada app)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# "live" em produção; "sandbox" só se o backend estiver com Stripe de teste
EXPO_PUBLIC_PAYMENTS_ENV=live

# Tamanho do código do e-mail (Supabase → Authentication → Email → OTP length)
EXPO_PUBLIC_OTP_LENGTH=6

# Diário de fotos (igual ao VITE_FEATURE_SELFIE_JOURNAL do web)
EXPO_PUBLIC_FEATURE_SELFIE_JOURNAL=false

# Links legais exigidos pelas lojas na tela de assinatura
EXPO_PUBLIC_TERMS_URL=https://prismanutri.belter-oracle.com.br/termos
EXPO_PUBLIC_PRIVACY_URL=https://prismanutri.belter-oracle.com.br/privacidade

# Só para o app.config.ts (não vão para dentro do app)
EAS_PROJECT_ID=
APP_BUNDLE_ID=br.com.belteroracle.prismanutri
